# EchoMind AI - Environment Variables Configuration
# Copy this file to .env (or backend/.env) and fill in your own values.

# --- Project Configuration ---
PROJECT_NAME="EchoMind AI"

# --- Speech-to-Text (STT) Settings ---
# Primary provider: "elevenlabs" (ElevenLabs Scribe Realtime STT)
# Optional fallback: "whisper"
STT_PROVIDER=elevenlabs
# ElevenLabs API Key (https://elevenlabs.io)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# --- AI Providers ---
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Backboard AI API Key (https://api.backboard.ai)
BACKBOARD_API_KEY=bb-your-backboard-api-key-here

# Default AI Provider and Model
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Database ---
DATABASE_URL=sqlite:///./echomind.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Security ---
SECRET_KEY=your-secure-random-32-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
