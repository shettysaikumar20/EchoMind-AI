# EchoMind AI - Environment Variables Configuration
# Copy this file to .env (or backend/.env) and fill in your own values.

# --- Project Configuration ---
PROJECT_NAME="EchoMind AI"

# --- AI Providers ---
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Backboard AI API Key (https://api.backboard.ai)
BACKBOARD_API_KEY=bb-your-backboard-api-key-here

# Default AI Provider and Model
# Options for AI_PROVIDER: "openrouter" | "backboard"
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Database ---
# For local development with SQLite:
DATABASE_URL=sqlite:///./echomind.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# --- Security ---
# Generate a secure 32+ character key for JWT token signing (e.g. openssl rand -hex 32)
SECRET_KEY=your-secure-random-32-character-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Speech-to-Text (STT) Settings ---
# Options: "lightweight" (client Web Speech / fallback) | "demo" | "faster-whisper" (local server-side STT)
STT_MODE=lightweight
