# EchoMind AI - Environment Variables Configuration

# --- AI Providers ---
# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Backboard AI API Key (https://api.backboard.ai)
BACKBOARD_API_KEY=bb-your-backboard-key

# Default AI Provider and Model
AI_PROVIDER=openrouter
AI_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Database ---
# For local SQLite:
DATABASE_URL=sqlite:///./echomind.db
# For production Supabase PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Security ---
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- STT ---
STT_MODE=lightweight
